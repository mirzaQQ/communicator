<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.communicator_1.gui.HelloController">
   <center>
      <VBox alignment="CENTER" prefHeight="388.0" prefWidth="601.0" spacing="20.0">
          <padding>
              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
          </padding>
         <children>
            <Label fx:id="lblUsername" text="&lt;&gt;" />
            <TextArea fx:id="txtChatId" prefHeight="200.0" prefWidth="200.0" />
            <HBox prefHeight="29.0" prefWidth="562.0">
               <children>
                  <TextField fx:id="txtMessagePanelId" prefHeight="26.0" prefWidth="253.0" />
                  <Button mnemonicParsing="false" onAction="#btnSend" text="send">
                     <HBox.margin>
                        <Insets left="25.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <left>
      <ListView fx:id="userLister" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </left>
</BorderPane>
